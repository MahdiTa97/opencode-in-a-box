# Copy to .env, then set a real password: openssl rand -base64 24
OPENCODE_PASSWORD=change-me

# Host identity, so files written inside /work stay owned by you.
HOST_UID=1000
HOST_GID=1000

# Optional: this host uses a manual proxy. Leave commented unless the
# container cannot reach the internet.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,::1

# Absolute host home. Needed because `sudo docker` sets HOME=/root.
HOST_HOME=/home/you

# The one host tree mounted read-write into the container at /work.
# Must be an absolute path, never / and never $HOME itself.
# Point it at /work to let the host open the worktrees the agent creates: a
# worktree's .git file stores an absolute path, so both sides need one name.
PROJECTS_DIR=/home/you/projects

# Optional. Context7 MCP API key - without it the server runs anonymously and
# is rate-limited. Get one at https://context7.com/dashboard
# CONTEXT7_API_KEY=ctx7_...

# Optional. Both images are pinned by digest so a moved tag cannot change what
# runs. Override only when pulling from a registry mirror (see README).
# NGINX_IMAGE=docker-mirror.example/library/nginx:1.27-alpine
